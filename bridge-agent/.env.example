# Copy to .env and fill in. build.sh / deploy.sh / publish.sh source this file.

PROJECT_ID=telix-agent-workshop
REGION=europe-west4
# Vertex AI location for Gemini model calls. "eu" = EU jurisdictional (data-resident) multi-region endpoint
# (aiplatform.eu.rep.googleapis.com); Gemini 3.x Flash is served there even when single EU regions return 404.
# Verified with setup/facilitator/05_verify.sh. Do NOT use "global" if EU residency is required.
MODEL_LOCATION=eu
GEMINI_MODEL=gemini-3.8-flash
STAGING_BUCKET=gs://telix-agent-workshop-adk-staging

# Gemini Enterprise app (location eu). PROJECT_NUMBER is resolved automatically if left empty.
GE_LOCATION=eu
GE_APP_ID=telix-gemini-enterprise
PROJECT_NUMBER=

# Project folder created by build.sh (26 chars max, lowercase, hyphens)
AGENT_PROJECT=telix-target-intel
DISPLAY_NAME="Telix Target Intelligence"
DESCRIPTION="Target biology, normal-tissue RNA and protein expression, structural confidence, and antibody-complex analysis grounded in DeepMind Science Skills (UniProt, GTEx, Human Protein Atlas, AlphaFold DB, RCSB PDB)"

# Runtime identity for the deployed agent (default: project compute SA). Agent identity is disabled because the
# EU jurisdictional endpoint rejects it (see deploy.sh).
RUNTIME_SA=

# Pin the science-skills checkout (tag/branch/commit). Leave empty for default branch.
SCIENCE_SKILLS_REF=
